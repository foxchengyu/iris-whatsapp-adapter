# Copy to .env and fill in your WhatsApp Cloud API credentials.
#
# All values can be obtained from the Meta for Developers dashboard:
#   https://developers.facebook.com/apps/
#
# Required.
WA_ACCESS_TOKEN=

# Required. Phone Number ID from your WhatsApp Business Account.
WA_PHONE_NUMBER_ID=

# Required for webhook verification. Any string you choose.
WA_VERIFY_TOKEN=

# Optional. HTTP proxy for restricted networks, e.g. http://proxy.example.com:8080
WA_PROXY=